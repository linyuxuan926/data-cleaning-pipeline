# Run python scripts/bootstrap.py to generate .env with random credentials.
# These placeholders are documentation only; do not deploy them as passwords.
DB_PASSWORD=replace-with-random-password
DB_ROOT_PASSWORD=replace-with-different-random-password
RABBITMQ_USER=cleaning
RABBITMQ_PASSWORD=replace-with-random-password
MINIO_ACCESS_KEY=cleaning-admin
MINIO_SECRET_KEY=replace-with-random-secret
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
WEB_PORT=8088

# Per-attempt execution time starts after claim; queue wait is separate (1 hour).
EXECUTION_TIMEOUT_SECONDS=1800
CANCEL_GRACE_SECONDS=10
# Dead attempt scratch is reaped at Worker startup; active attempts are never reaped.
SCRATCH_RETENTION_SECONDS=3600
DISK_BATCH_ROWS=1000
MAX_SCRATCH_BYTES=1073741824
BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-username
BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-admin-password
